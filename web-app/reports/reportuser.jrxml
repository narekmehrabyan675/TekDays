    <parameter name="userId" class="java.lang.String"/>
    <queryString language="SQL">
        <![CDATA[SELECT
     tek_user.`id` AS tek_user_id,
     tek_user.`version` AS tek_user_version,
     tek_user.`bio` AS tek_user_bio,
     tek_user.`email` AS tek_user_email,
     tek_user.`full_name` AS tek_user_full_name,
     tek_user.`password` AS tek_user_password,
     tek_user.`user_name` AS tek_user_user_name,
     tek_user.`website` AS tek_user_website,
     tek_user.`activated` AS tek_user_activated
FROM
     `tek_user` tek_user
WHERE tek_user.id = $P{userId}]]>
    </queryString>
